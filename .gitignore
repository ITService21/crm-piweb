# ---------------------------------------------------------------
# Secrets & local config  (NEVER commit: DB password, JWT secret, admin password)
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
backup.cnf
*.cnf

# ---------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.npm/
.yarn/
.pnpm-store/

# ---------------------------------------------------------------
# Build output (rebuilt with `npm run build` on the server)
# ---------------------------------------------------------------
dist/
build/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------
# Logs & runtime files
# ---------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pm2/
*.pid
*.pid.lock

# ---------------------------------------------------------------
# Database dumps & backups (contain customer data)
# ---------------------------------------------------------------
*.sql
!backend/migrations/*.sql
*.sql.gz
*.sql.zip
*.dump
*.bak
*.sqlite
*.sqlite3
backups/

# ---------------------------------------------------------------
# Test, coverage & tooling output
# ---------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
.cache/
.eslintcache
.stylelintcache
*.tgz

# ---------------------------------------------------------------
# Editor, OS & tool files
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
.claude/

# ---------------------------------------------------------------
# Scratch / temp
# ---------------------------------------------------------------
tmp/
temp/
*.tmp

# NOTE: package-lock.json is intentionally committed so `npm ci` installs the exact tested versions.

# Uploaded payment proofs (client data) — never commit
backend/uploads/
uploads/
