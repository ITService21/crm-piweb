# Dedicated server block: ADD as a NEW file (e.g. /etc/nginx/sites-available/crm.piwebtechnology.com).
# Do not edit existing site files. Replace <PORT> with the unused port you choose after inspection.
server {
    listen 80;
    server_name crm.piwebtechnology.com;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    # 308 (not 301) so a POST to http:// is replayed as a POST, not turned into a GET
    location / { return 308 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name crm.piwebtechnology.com;
    ssl_certificate     /etc/letsencrypt/live/crm.piwebtechnology.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/crm.piwebtechnology.com/privkey.pem;

    root /var/www/piweb-crm/frontend/dist;
    index index.html;
    client_max_body_size 12m;   # payment-proof uploads (8 MB per file, a few files at once); everything else is tiny

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    location /api/    { proxy_pass http://127.0.0.1:<PORT>; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; }

    # Socket.IO needs the WebSocket upgrade headers and a long read timeout.
    location /socket.io/ {
        proxy_pass http://127.0.0.1:<PORT>;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
    }

    location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }
    location / { try_files $uri /index.html; }
}
