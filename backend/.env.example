# ---- Copy to backend/.env and fill in. Never commit .env. ----
NODE_ENV=production
# Local-only port (Nginx proxies to it). Pick one that `sudo ss -ltnp` shows as free.
PORT=4000

# ---- MySQL / MariaDB (dedicated database + user) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=piweb_crm
DB_USER=piweb_crm
DB_PASSWORD=change-me
# Optional: connect through a unix socket instead of host/port
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# ---- Security ----
# Generate with: openssl rand -hex 48   (min 32 chars, required in production)
JWT_SECRET=
# How many days a login lasts (default 7). Disabled users are locked out immediately regardless.
SESSION_DAYS=7
# Required behind Nginx/HTTPS so the login cookie is Secure
COOKIE_SECURE=true
# Number of reverse proxies in front of Node (Nginx = 1). Without this every visitor
# looks like 127.0.0.1 and the rate limits become global instead of per-visitor.
TRUST_PROXY=1

# ---- Business settings ----
BUSINESS_TZ=Asia/Kolkata
DEFAULT_COUNTRY_CODE=91
# Public URL of the CRM (Socket.IO CORS)
APP_ORIGIN=https://crm.piwebtechnology.com

# ---- Email (quotations & invoices). Leave SMTP_HOST empty to disable sending; PDFs can still be downloaded. ----
# Google Workspace / Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, and SMTP_PASS = a 16-letter *App password*
# (Google Account -> Security -> 2-Step Verification -> App passwords). Other providers: use their SMTP details.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# "Name <address>" shown to clients; defaults to SMTP_USER
MAIL_FROM=
# Optional: where client replies go
MAIL_REPLY_TO=

# Payment-proof screenshots are stored here (outside the web root, served only to logged-in users).
# Default: backend/uploads. In production use an absolute path and include it in your backups.
UPLOAD_DIR=

# ---- First admin: used only by `npm run seed`, then remove them ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
